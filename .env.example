# Local development — talk directly to FastAPI on port 8002
# Start backend: cd Survey-Backend && uvicorn main:app --host 0.0.0.0 --port 8002 --reload
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8002

# Used by next.config.ts rewrites when NEXT_PUBLIC_API_BASE_URL is empty (production)
API_BACKEND_URL=http://127.0.0.1:8000
