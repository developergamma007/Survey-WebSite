# Local development — talk directly to FastAPI on port 8002
# Start backend: cd Survey-Backend && uvicorn main:app --host 0.0.0.0 --port 8002 --reload
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8002

# Used by next.config.ts rewrites when NEXT_PUBLIC_API_BASE_URL is empty (production)
API_BACKEND_URL=http://127.0.0.1:8000

# Public URL of this admin site (Excel export audio links when not running in a browser)
# NEXT_PUBLIC_SITE_URL=https://peoplepulse.iswot.in

# Google Maps JavaScript API (Volunteer Analysis map). Restrict key by HTTP referrer in Google Cloud.
# Set at build time and/or as GOOGLE_MAPS_API_KEY on the Node process for runtime via /api/client-config.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
